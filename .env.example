# OpenReels API Keys
# Copy this file to .env and fill in your keys
#
# Docker: docker run --env-file .env --shm-size=2gb -v ./output:/output openreels "your topic"
# Local:  pnpm start "your topic"

# Required: LLM provider (at least one)
# Anthropic (default): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI (--provider openai): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: Text-to-Speech (at least one)
# ElevenLabs (default): https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Inworld (--tts-provider inworld): https://inworld.ai/
INWORLD_TTS_API_KEY=

# Required: AI Image Generation (at least one)
# Gemini (default): https://aistudio.google.com/apikey
# OpenAI GPT Image (--image-provider openai): uses OPENAI_API_KEY above
GOOGLE_API_KEY=

# Optional: OpenRouter (--provider openrouter): https://openrouter.ai/
OPENROUTER_API_KEY=

# Optional: Tavily web search (--search-provider tavily): https://tavily.com/
# Required when using OpenRouter/OpenAI-compatible providers for web research
TAVILY_API_KEY=

# Optional: OpenAI-compatible endpoint (--provider openai-compatible)
# OPENREELS_LLM_BASE_URL=http://localhost:11434/v1
# OPENREELS_LLM_MODEL=llama3:8b
# OPENREELS_LLM_API_KEY=
# Auth mode: auto (default, Bearer when a key is set), bearer, custom-header, none
# OPENREELS_LLM_AUTH=auto
# Header used by OPENREELS_LLM_AUTH=custom-header
# OPENREELS_LLM_AUTH_HEADER=x-api-key

# Optional: Stock footage (free, but requires registration)
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional: API server
# Require this key on every API route except /health. The web app opens on a
# sign-in screen and will not render until the key is entered.
# Clients may send Authorization: Bearer <key>, X-API-Key: <key>, or ?api_key=<key>.
# OPENREELS_API_KEY=
# Fail closed: with no key configured, answer 503 on every API route instead of
# serving the whole surface. Set this on any host the public can reach.
# OPENREELS_AUTH_REQUIRED=false
# Comma-separated browser origins, "*" for any, or "false" to disable CORS.
# OPENREELS_CORS_ORIGIN=*
# Allow webhook callbacks to private/internal addresses (trusted networks only).
# OPENREELS_ALLOW_PRIVATE_CALLBACKS=false
# Default every job to stock media + procedural text cards (no AI image/video).
# OPENREELS_NO_AI_ASSETS=false

# Optional: LLM resilience
# Per-request ceiling for LLM calls, in milliseconds.
# OPENREELS_LLM_TIMEOUT_MS=180000
# Comma-separated backup models, tried in order when the primary model fails.
# OPENREELS_LLM_FALLBACK_MODELS=
# Total wall-clock budget for the fallback chain, in milliseconds.
# OPENREELS_LLM_FALLBACK_BUDGET_MS=300000
# How long a single model may spend retrying a rate limit before the chain
# moves on to the next model, in milliseconds.
# OPENREELS_LLM_FALLBACK_RETRY_BUDGET_MS=45000

# Optional: Local narration (Piper)
# Piper runs the ONNX voice natively and synthesises at roughly twenty times
# faster than real time. The container image installs it at these paths.
# PIPER_BINARY=/opt/piper/piper
# PIPER_MODEL=/opt/piper-voices/en_GB-alan-medium.onnx

# Optional: Render tuning (CPU-only servers)
# H.264 quality. Higher is smaller. 23 is roughly a third the size of the
# default and is invisible after YouTube re-encodes.
# OPENREELS_RENDER_CRF=23
# Remotion delayRender timeout, in milliseconds. Raise this on small VMs.
# OPENREELS_RENDER_TIMEOUT_MS=120000
# Parallel browser tabs used to render frames. 1 is fastest on 1-2 vCPU boxes.
# OPENREELS_RENDER_CONCURRENCY=1
# OffthreadVideo frame cache in MB. Prevents re-extracting the same frame.
# OPENREELS_RENDER_OFFTHREAD_CACHE_MB=1024

